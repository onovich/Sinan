{
  "schemaVersion": 1,
  "id": "ev_switch_a_open_gate",
  "name": "Switch opens gate safely",
  "trigger": {
    "type": "entity.interact",
    "entityId": "switch_a"
  },
  "condition": {
    "all": [
      {
        "type": "flag.equals",
        "flag": "power_enabled",
        "value": true
      },
      {
        "type": "inventory.hasItem",
        "itemId": "gate_key"
      }
    ]
  },
  "actions": [
    {
      "type": "switch.setState",
      "entityId": "switch_a",
      "value": true
    },
    {
      "type": "door.open",
      "entityId": "gate_a"
    },
    {
      "type": "camera.playShot",
      "shotId": "cam_gate_reveal"
    },
    {
      "type": "entity.animateTransform",
      "entityId": "switch_a",
      "to": {
        "position": [3.2, 1.05, 4.6],
        "rotation": [0, 0, 0, 1],
        "scale": [1.55, 1.55, 1.55]
      },
      "duration": 0.2,
      "ease": "easeOutCubic"
    },
    {
      "type": "flag.set",
      "flag": "gate_a_opened",
      "value": true
    },
    {
      "type": "timeline.play",
      "timelineId": "tl_open_gate"
    }
  ]
}
